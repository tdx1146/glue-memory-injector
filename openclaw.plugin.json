{
  "id": "glue-memory-injector",
  "name": "Glue Memory Injector",
  "description": "每轮对话前经胶水层 /recall 注入记忆上下文（fail-open 绝不阻塞主循环；限流 ≥2s；结果截断 ≤1500 字）。依赖 glue_server 127.0.0.1:19000 运行。",
  "version": "1.0.0",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "总开关（false 时 hook 直接返回，不调胶水层）"
      },
      "glueUrl": {
        "type": "string",
        "default": "http://127.0.0.1:19000",
        "description": "胶水层 HTTP 地址（glue_server）"
      },
      "k": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "default": 8,
        "description": "召回条数"
      },
      "minIntervalMs": {
        "type": "integer",
        "minimum": 0,
        "default": 2000,
        "description": "两次召回最小间隔（毫秒），限流防抖"
      },
      "maxChars": {
        "type": "integer",
        "minimum": 200,
        "maximum": 4000,
        "default": 1500,
        "description": "注入上下文文本上限（字符），防爆上下文"
      },
      "storeTurn": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "写侧自动入库开关（阶段2灰度默认关；开启后 agent_end 每轮经 glue /store-turn 写 LMS /store）"
          },
          "sessionIds": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["main"],
            "description": "允许自动写入的会话白名单（默认 main，与 LMS /store 白名单对齐）"
          },
          "minIntervalMs": {
            "type": "integer",
            "minimum": 0,
            "default": 3000,
            "description": "两次自动写入最小间隔（毫秒），防写放大"
          },
          "userMaxChars": {
            "type": "integer",
            "minimum": 1,
            "default": 2000,
            "description": "user_input 截断上限（字符）"
          },
          "outputMaxChars": {
            "type": "integer",
            "minimum": 1,
            "default": 20000,
            "description": "llm_output 截断上限（字符）"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 30000,
            "default": 28000,
            "description": "写请求 AbortSignal 超时（2026-09-20 重标：手机 bge-m3 ≈4.5–6.5ms/字，整回合文本单次 embed 8–17s + process ~3.4s；28s = glue 25s +3s 余量，仍 < 30s hook 预算）"
          },
          "sourceKindEnabled": {
            "type": "boolean",
            "default": true,
            "description": "人机标记开关（2026-09-19）：true 时用户回合 payload 带 source_kind='user'、INTERSESSION 带 'agent'（落 archive，供判据侧读）；false = 不发该字段（旧 wire 形状零变化）"
          }
        }
      }
    }
  }
}
